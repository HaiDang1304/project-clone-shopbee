# MongoDB connection string
# Example (local): mongodb://127.0.0.1:27017/thuongmaidientu
# Example (Atlas): mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/thuongmaidientu
MONGODB_URI=mongodb://127.0.0.1:27017/thuongmaidientu

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (SMTP)
# For Gmail SMTP: host=smtp.gmail.com, port=587, secure=false, use App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ShopBee <your_email@gmail.com>"

# OTP
OTP_SECRET=change_me_too

# Google OAuth (Web client ID from Google Console)
GOOGLE_CLIENT_ID=

# Server
PORT=5000

# CORS
CORS_ORIGIN=http://localhost:5173
