# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shopbee_clone
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# OTP
OTP_SECRET=change_me_too
OTP_EXPIRES_MINUTES=10
# Set true only for local debugging if you want the API response to include devVerificationCode.
RETURN_OTP_IN_RESPONSE=false

# Email
# local: console logs OTP to backend terminal
# smtp: send OTP through SMTP
EMAIL_DELIVERY=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ShopBee <your_email@gmail.com>"

# Google OAuth Web client ID from Google Console
GOOGLE_CLIENT_ID=

# GHTK shipping fee API
GHTK_TOKEN=
GHTK_PARTNER_CODE=
GHTK_FEE_URL=https://services.giaohangtietkiem.vn/services/shipment/fee
GHTK_TRANSPORT=road
# Either configure a saved GHTK pickup address id:
GHTK_PICK_ADDRESS_ID=
# Or configure pickup address fields:
GHTK_PICK_ADDRESS=
GHTK_PICK_PROVINCE=
GHTK_PICK_DISTRICT=
GHTK_PICK_WARD=
GHTK_PICK_STREET=
