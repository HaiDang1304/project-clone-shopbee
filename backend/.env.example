# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shopbee_clone
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# OTP
OTP_SECRET=change_me_too
OTP_EXPIRES_MINUTES=10
# Set true only for local debugging if you want the API response to include devVerificationCode.
RETURN_OTP_IN_RESPONSE=false

# Email
# local: console logs OTP to backend terminal
# smtp: send OTP through SMTP
EMAIL_DELIVERY=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ShopBee <your_email@gmail.com>"

# Google OAuth Web client ID from Google Console
GOOGLE_CLIENT_ID=

# Frontend base URL used to build payment return/cancel links
FRONTEND_URL=http://localhost:5173

# payOS bank transfer QR payment
PAYOS_CLIENT_ID=bd1341d9-4a64-4b9e-9f08-9b1186ed3aef
PAYOS_API_KEY=483f9484-a9d5-4077-97a5-ef5c427097ce
PAYOS_CHECKSUM_KEY=11ae281055cc50fb6bf1a0ae555043f511caecb48d7ede10ec0a1ee17a6422b0
# Optional. Leave empty to auto-build /order-success?orderId=...
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
# Configure this URL in payOS dashboard: https://your-domain.com/api/orders/payos/webhook
