{
  "name": "backend",
  "version": "1.0.0",
  "description": "ShopBee backend API using Express and MySQL",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "db:schema": "mysql -u root -p < database/schema.sql",
    "db:seed": "mysql -u root -p shopbee_clone < database/seed.sql",
    "db:migrate:profile": "mysql -u root -p < database/migrations/20260602_add_user_profile_fields.sql",
    "db:migrate:address-location": "mysql -u root -p < database/migrations/20260602_add_user_address_location_fields.sql",
    "db:migrate:shop-applications": "mysql -u root -p < database/migrations/20260603_add_shop_applications.sql",
    "db:migrate:product-weight": "mysql -u root -p < database/migrations/20260607_add_product_weight_grams.sql",
    "db:migrate:product-metadata": "mysql -u root -p < database/migrations/20260606_add_product_metadata.sql",
    "db:migrate:checkout-options": "mysql -u root -p < database/migrations/20260606_add_checkout_selected_options.sql",
    "db:migrate:notifications": "mysql -u root -p < database/migrations/20260607_add_notifications.sql",
    "db:migrate:internal-shipping": "mysql -u root -p < database/migrations/20260607_simplify_shipping_address_two_levels.sql",
    "db:migrate:shipping-two-levels": "mysql -u root -p < database/migrations/20260607_simplify_shipping_address_two_levels.sql",
    "db:migrate:drop-product-variants": "mysql -u root -p < database/migrations/20260608_drop_product_variants.sql",
    "db:seed:shipping-locations": "mysql -u root -p shopbee_clone < database/seed_shipping_locations.sql",
    "db:seed:address-data": "node scripts/seedAddressData.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^7.0.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
